<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secret Game</title>
    <link rel="stylesheet" href="/play.css">
</head>
<body>
    <div class="entry">
        {{#if state}}
            <h3>you won</h3>
            <p>{{count}} guesses</p>

            <form action="reset" method="POST">
                <button type="submit" autofocus>Play Again</button>
            </form>
        {{else if debug}}
            <h3>Debug Mode</h3>
            <p>#{{secret}}#</p>

            <h3>Guess a number!</h3>
            <form action="guess" method="POST">
                <input type="text" name="guess" placeholder="Enter your guess" autofocus>
                <button type="submit">Submit</button>
            </form>

        {{else if invalidGuess}}
            <h3>Invalid Guess!</h3>
            <form action="guess" method="POST">
                <input type="text" name="guess" placeholder="Enter your guess" autofocus>
                <button type="submit">Submit</button>
            </form>

        {{else}}
            <h3>Guess a number!</h3>
            <form action="guess" method="POST">
                <input type="text" name="guess" placeholder="Enter your guess" autofocus>
                <button type="submit">Submit</button>
            </form>
        {{/if}}

         <ol class="guess_list">
                {{#each guesses}}
                    <li class="{{status}}">
                        <p>{{guess}} {{message}}</p>
                    </li>
                {{/each}}
            </ol> 
    </div>
</body>
</html>